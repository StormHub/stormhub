<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The MCP Skills extension APIs are marked experimental. -->
    <NoWarn>$(NoWarn);MCPEXP005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Skills" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Skills\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
