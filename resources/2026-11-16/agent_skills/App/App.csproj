<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- MCP-based skills (MCPEXP001) and the OpenAI Responses client (OPENAI001) are experimental. -->
    <NoWarn>$(NoWarn);MCPEXP001;OPENAI001</NoWarn>
    <UserSecretsId>c387b383-27a4-4b89-9245-3c4893a40953</UserSecretsId>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.28.0-preview.261106.1" />
    <PackageReference Include="Microsoft.Agents.AI.Mcp" Version="1.28.0-alpha.261106.1" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.28.0" />
    <PackageReference Include="OpenAI" Version="2.15.0" />
  </ItemGroup>

</Project>
